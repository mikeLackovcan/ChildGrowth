{
  "expo": {
    "name": "QuestBlox",
    "slug": "QuestBlox",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/app-icon-v2.png",
    "scheme": "questblox",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/app-icon-v2.png"
    },
    "android": {
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#0648CA",
        "foregroundImage": "./assets/images/android-icon-foreground-v2.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.questblox.app"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/app-icon-v2.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/android-icon-monochrome.png",
          "color": "#208AEF"
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": false
        }
      ],
      "expo-asset",
      "expo-font",
      "expo-image",
      "expo-web-browser",
      "@react-native-google-signin/google-signin"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "1bdc67da-0f1e-439f-83ae-58e4183f0e55"
      }
    },
    "owner": "misko7",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/1bdc67da-0f1e-439f-83ae-58e4183f0e55"
    }
  }
}
