{
  "expo": {
    "name": "Quest Champ",
    "slug": "quest-hero",
    "description": "A playful kids habit and chore companion with quests, focus timers, reminders, rewards, and parent controls.",
    "version": "1.0.0",
    "runtimeVersion": { "policy": "fingerprint" },
    "updates": {
      "url": "https://u.expo.dev/daed5f3a-fd4f-44a8-9b72-be86f5b6f2a2",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "orientation": "portrait",
    "icon": "./assets/branding/quest-hero-icon-1024.png",
    "scheme": "questhero",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/branding/quest-hero-icon-1024.png"
    },
    "android": {
      "softwareKeyboardLayoutMode": "resize",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#081A4B",
        "foregroundImage": "./assets/branding/quest-hero-adaptive.png",
        "monochromeImage": "./assets/branding/quest-q-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.questhero.app"
    },
    "androidStatusBar": {
      "backgroundColor": "#FFFFFF",
      "barStyle": "dark-content",
      "translucent": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/branding/quest-hero-favicon.png"
    },
    "plugins": [
      "@react-native-google-signin/google-signin",
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#081A4B",
          "image": "./assets/branding/quest-hero-icon-1024.png",
          "imageWidth": 160
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/branding/quest-q-monochrome.png",
          "color": "#3270EB",
          "sounds": [
            "./assets/audio/habi_reminder.wav",
            "./assets/audio/habi_alarm.wav",
            "./assets/audio/habi_complete.wav"
          ]
        }
      ],
      [
        "expo-camera",
        {
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": true
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": false
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true
          }
        }
      ],
      "./plugins/withOptionalCameraFeatures.cjs",
      "./plugins/withHeroNotification.cjs",
      "expo-asset",
      "expo-font",
      "expo-image",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "daed5f3a-fd4f-44a8-9b72-be86f5b6f2a2"
      }
    },
    "owner": "misko7"
  }
}
