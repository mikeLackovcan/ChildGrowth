{
  "expo": {
    "name": "Quest Habi",
    "slug": "quest-hero",
    "description": "A playful kids habit and chore companion with quests, focus timers, reminders, rewards, and parent controls.",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/branding/questpip-icon-1024.png",
    "scheme": "questhero",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/branding/questpip-icon-1024.png"
    },
    "android": {
      "versionCode": 1,
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#081A4B",
        "foregroundImage": "./assets/branding/questpip-adaptive.png",
        "monochromeImage": "./assets/branding/questpip-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.questhero.app"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/branding/questpip-favicon.png"
    },
    "plugins": [
      "@react-native-google-signin/google-signin",
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#081A4B",
          "image": "./assets/branding/questpip-icon-1024.png",
          "imageWidth": 160
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/branding/questpip-monochrome.png",
          "color": "#3270EB",
          "sounds": [
            "./assets/audio/habi-reminder.wav",
            "./assets/audio/habi-alarm.wav",
            "./assets/audio/habi-complete.wav"
          ]
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": false
        }
      ],
      "expo-asset",
      "expo-font",
      "expo-image",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "daed5f3a-fd4f-44a8-9b72-be86f5b6f2a2"
      }
    },
    "owner": "misko7"
  }
}
