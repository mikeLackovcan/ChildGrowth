{
  "expo": {
    "name": "QuestBlox",
    "slug": "QuestBlox",
    "description": "A playful family quest tracker that turns everyday tasks into rewards, progress, and adventures.",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/branding/quest-hero-icon-1024.png",
    "scheme": "questblox",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/branding/quest-hero-icon-1024.png"
    },
    "android": {
      "versionCode": 1,
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#081A4B",
        "foregroundImage": "./assets/branding/quest-hero-adaptive.png",
        "monochromeImage": "./assets/branding/quest-q-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.questblox.app"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/branding/quest-hero-favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#081A4B",
          "image": "./assets/branding/quest-hero-icon-1024.png",
          "imageWidth": 160
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/branding/quest-q-monochrome.png",
          "color": "#3270EB"
        }
      ],
      "expo-audio",
      "expo-asset",
      "expo-font",
      "expo-image",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "1bdc67da-0f1e-439f-83ae-58e4183f0e55"
      }
    },
    "owner": "misko7"
  }
}
