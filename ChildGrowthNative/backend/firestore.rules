rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function owner(uid) { return signedIn() && request.auth.uid == uid; }
    function acceptedParent(childUid) {
      return signedIn()
        && exists(/databases/$(database)/documents/familyAccess/$(childUid)/parents/$(request.auth.uid))
        && get(/databases/$(database)/documents/familyAccess/$(childUid)/parents/$(request.auth.uid)).data.accepted == true;
    }
    match /profiles/{uid} {
      allow get: if owner(uid) || acceptedParent(uid);
      allow list, write: if false;
    }
    match /user_data/{uid} {
      allow get: if owner(uid) || acceptedParent(uid);
      allow list, write: if false;
    }
    match /battles/{id} {
      allow read: if signedIn() && request.auth.uid in resource.data.participants;
      allow write: if false;
    }
    match /familyLinks/{id} {
      allow read: if signedIn() && request.auth.uid in resource.data.participants;
      allow write: if false;
    }
    // Membership grants, nickname reservations, push tokens, outboxes, jobs and
    // quotas are server-only. Never use legacy display summaries as access grants.
    match /{document=**} { allow read, write: if false; }
  }
}
