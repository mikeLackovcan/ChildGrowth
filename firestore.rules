rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function owns(uid) { return signedIn() && request.auth.uid == uid; }
    function accountAuth() {
      return signedIn() && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }
    function parentAccount() {
      return accountAuth()
        && get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.role == 'parent';
    }
    function guardianLink(childUid, parentUid) {
      return exists(/databases/$(database)/documents/family_guardians/$(childUid + '_' + parentUid))
        && get(/databases/$(database)/documents/family_guardians/$(childUid + '_' + parentUid)).data.status == 'active';
    }
    function primaryManagedParent(childUid) {
      return parentAccount()
        && get(/databases/$(database)/documents/family_children/$(childUid)).data.parent_uid == request.auth.uid;
    }
    function managedParent(childUid) {
      return primaryManagedParent(childUid) || (parentAccount() && guardianLink(childUid, request.auth.uid));
    }
    function managedParentAfter(childUid) {
      return parentAccount()
        && getAfter(/databases/$(database)/documents/family_children/$(childUid)).data.parent_uid == request.auth.uid;
    }
    function boundDevice(childUid) {
      return signedIn()
        && exists(/databases/$(database)/documents/family_devices/$(request.auth.uid))
        && get(/databases/$(database)/documents/family_devices/$(request.auth.uid)).data.child_uid == childUid
        && (get(/databases/$(database)/documents/family_devices/$(request.auth.uid)).data.parent_uid
          == get(/databases/$(database)/documents/family_children/$(childUid)).data.parent_uid
          || guardianLink(childUid, get(/databases/$(database)/documents/family_devices/$(request.auth.uid)).data.parent_uid));
    }
    function approvedInvite(childUid, parentUid) {
      return exists(/databases/$(database)/documents/family_invites/$(childUid + '_' + parentUid))
        && get(/databases/$(database)/documents/family_invites/$(childUid + '_' + parentUid)).data.status == 'approved';
    }
    function isApprovedParentOf(childUid) {
      return signedIn() && approvedInvite(childUid, request.auth.uid);
    }

    match /profiles/{uid} {
      allow read: if accountAuth();
      allow create, update: if owns(uid) && accountAuth()
        && request.resource.data.keys().hasOnly(['nickname', 'full_name', 'role', 'family_code', 'updated_at'])
        && request.resource.data.role in ['parent', 'child']
        && (!('family_code' in request.resource.data)
          || request.resource.data.family_code.matches('^[A-HJ-NP-Z2-9]{8}$'));
      allow delete: if owns(uid);
    }

    match /family_account_codes/{code} {
      // A code only addresses an approval request; it never grants family access.
      allow get: if accountAuth();
      allow list: if false;
      allow create, update: if accountAuth()
        && code.matches('^[A-HJ-NP-Z2-9]{8}$')
        && request.resource.data.keys().hasOnly(['uid', 'role'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.role == 'child'
        && get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.role == 'child'
        && (!exists(/databases/$(database)/documents/family_account_codes/$(code))
          || resource.data.uid == request.auth.uid);
      allow delete: if accountAuth() && resource.data.uid == request.auth.uid;
    }

    match /family_children/{childUid} {
      allow create: if parentAccount()
        && request.resource.data.keys().hasOnly(['uid', 'parent_uid', 'nickname', 'full_name', 'role'])
        && request.resource.data.uid == childUid
        && request.resource.data.parent_uid == request.auth.uid
        && request.resource.data.role == 'child'
        && request.resource.data.full_name is string
        && request.resource.data.full_name.size() > 0
        && request.resource.data.full_name.size() <= 30;
      allow get: if managedParent(childUid) || boundDevice(childUid);
      allow list: if parentAccount() && resource.data.parent_uid == request.auth.uid;
      allow update: if managedParent(childUid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['full_name'])
        && request.resource.data.full_name is string
        && request.resource.data.full_name.size() > 0
        && request.resource.data.full_name.size() <= 30;
      allow delete: if primaryManagedParent(childUid);
    }

    match /family_progress/{childUid} {
      allow get: if managedParent(childUid) || boundDevice(childUid);
      allow create: if managedParentAfter(childUid) || boundDevice(childUid);
      allow update: if managedParent(childUid) || boundDevice(childUid);
      allow delete: if primaryManagedParent(childUid);
    }

    match /family_codes/{code} {
      allow create: if code.matches('^[A-HJ-NP-Z2-9]{12}$')
        && request.resource.data.keys().hasOnly(['child_uid', 'parent_uid', 'expires_at', 'claimed_by'])
        && primaryManagedParent(request.resource.data.child_uid)
        && request.resource.data.parent_uid == request.auth.uid
        && request.resource.data.claimed_by == ''
        && request.resource.data.expires_at is timestamp
        && request.resource.data.expires_at > request.time
        && request.resource.data.expires_at <= request.time + duration.value(16, 'm');
      // Codes cannot be listed by devices. Possession of a high-entropy code is required.
      allow get: if signedIn() && (request.auth.token.firebase.sign_in_provider == 'anonymous'
        || (parentAccount() && resource.data.parent_uid == request.auth.uid));
      allow list, delete: if parentAccount() && resource.data.parent_uid == request.auth.uid;
      allow update: if signedIn() && request.auth.token.firebase.sign_in_provider == 'anonymous'
        && resource.data.claimed_by == ''
        && resource.data.expires_at > request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['claimed_by'])
        && request.resource.data.claimed_by == request.auth.uid
        && getAfter(/databases/$(database)/documents/family_devices/$(request.auth.uid)).data.code == code
        && getAfter(/databases/$(database)/documents/family_devices/$(request.auth.uid)).data.child_uid == resource.data.child_uid;
    }

    match /family_devices/{deviceUid} {
      allow get: if owns(deviceUid) || (parentAccount() && resource.data.parent_uid == request.auth.uid);
      allow list: if parentAccount() && resource.data.parent_uid == request.auth.uid;
      allow create: if owns(deviceUid) && request.auth.token.firebase.sign_in_provider == 'anonymous'
        && request.resource.data.keys().hasOnly(['parent_uid', 'child_uid', 'code'])
        && get(/databases/$(database)/documents/family_codes/$(request.resource.data.code)).data.claimed_by == ''
        && get(/databases/$(database)/documents/family_codes/$(request.resource.data.code)).data.expires_at > request.time
        && getAfter(/databases/$(database)/documents/family_codes/$(request.resource.data.code)).data.claimed_by == deviceUid
        && getAfter(/databases/$(database)/documents/family_codes/$(request.resource.data.code)).data.child_uid == request.resource.data.child_uid
        && getAfter(/databases/$(database)/documents/family_codes/$(request.resource.data.code)).data.parent_uid == request.resource.data.parent_uid
        && (get(/databases/$(database)/documents/family_children/$(request.resource.data.child_uid)).data.parent_uid == request.resource.data.parent_uid
          || guardianLink(request.resource.data.child_uid, request.resource.data.parent_uid));
      allow delete: if owns(deviceUid) || (parentAccount() && resource.data.parent_uid == request.auth.uid);
    }

    match /family_guardian_codes/{code} {
      allow create: if code.matches('^[A-HJ-NP-Z2-9]{12}$')
        && request.resource.data.keys().hasOnly(['child_uid', 'device_uid', 'expires_at', 'claimed_by'])
        && request.resource.data.device_uid == request.auth.uid
        && boundDevice(request.resource.data.child_uid)
        && request.resource.data.claimed_by == ''
        && request.resource.data.expires_at is timestamp
        && request.resource.data.expires_at > request.time
        && request.resource.data.expires_at <= request.time + duration.value(16, 'm');
      allow get: if signedIn() && (owns(resource.data.device_uid) || parentAccount());
      allow list: if (signedIn() && request.auth.token.firebase.sign_in_provider == 'anonymous'
        && resource.data.device_uid == request.auth.uid)
        || primaryManagedParent(resource.data.child_uid);
      allow update: if parentAccount()
        && resource.data.claimed_by == ''
        && resource.data.expires_at > request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['claimed_by'])
        && request.resource.data.claimed_by == request.auth.uid
        && getAfter(/databases/$(database)/documents/family_guardians/$(resource.data.child_uid + '_' + request.auth.uid)).data.code == code;
      allow delete: if owns(resource.data.device_uid)
        || (parentAccount() && resource.data.claimed_by == request.auth.uid)
        || primaryManagedParent(resource.data.child_uid);
    }

    match /family_guardians/{guardianId} {
      allow create: if parentAccount()
        && request.resource.data.keys().hasOnly(['child_uid', 'parent_uid', 'parent_name', 'code', 'status', 'created_at'])
        && guardianId == request.resource.data.child_uid + '_' + request.auth.uid
        && request.resource.data.parent_uid == request.auth.uid
        && request.resource.data.parent_name is string
        && request.resource.data.parent_name.size() > 0
        && request.resource.data.parent_name.size() <= 30
        && request.resource.data.status == 'active'
        && get(/databases/$(database)/documents/family_guardian_codes/$(request.resource.data.code)).data.claimed_by == ''
        && get(/databases/$(database)/documents/family_guardian_codes/$(request.resource.data.code)).data.expires_at > request.time
        && get(/databases/$(database)/documents/family_guardian_codes/$(request.resource.data.code)).data.child_uid == request.resource.data.child_uid
        && getAfter(/databases/$(database)/documents/family_guardian_codes/$(request.resource.data.code)).data.claimed_by == request.auth.uid;
      allow get: if (parentAccount() && (resource.data.parent_uid == request.auth.uid
        || primaryManagedParent(resource.data.child_uid))) || boundDevice(resource.data.child_uid);
      allow list: if signedIn() && ((parentAccount() && resource.data.parent_uid == request.auth.uid)
        || primaryManagedParent(resource.data.child_uid)
        || boundDevice(resource.data.child_uid));
      allow delete: if primaryManagedParent(resource.data.child_uid) || owns(resource.data.parent_uid);
    }

    match /family_invites/{inviteId} {
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
          'id', 'child_uid', 'parent_uid', 'child_nickname', 'parent_nickname',
          'participant_uids', 'created_by', 'status', 'updated_at'
        ])
        && request.resource.data.created_by == request.auth.uid
        && request.resource.data.child_uid != request.resource.data.parent_uid
        && request.resource.data.participant_uids is list
        && request.resource.data.participant_uids.size() == 2
        && request.resource.data.participant_uids.hasAll([
          request.resource.data.child_uid,
          request.resource.data.parent_uid
        ])
        && request.auth.uid in request.resource.data.participant_uids
        && request.resource.data.status == 'pending'
        && inviteId == request.resource.data.child_uid + '_' + request.resource.data.parent_uid
        && exists(/databases/$(database)/documents/profiles/$(request.resource.data.child_uid))
        && exists(/databases/$(database)/documents/profiles/$(request.resource.data.parent_uid))
        && get(/databases/$(database)/documents/profiles/$(request.resource.data.child_uid)).data.role == 'child'
        && get(/databases/$(database)/documents/profiles/$(request.resource.data.parent_uid)).data.role == 'parent';
      allow read, delete: if signedIn() && request.auth.uid in resource.data.participant_uids;
      allow update: if signedIn()
        && request.auth.uid in resource.data.participant_uids
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'answered_by', 'updated_at'])
        && request.resource.data.status in ['approved', 'denied']
        && (request.resource.data.status == 'denied' || request.auth.uid != resource.data.created_by);
    }

    match /user_data/{uid} {
      allow create: if owns(uid);
      allow read: if owns(uid) || isApprovedParentOf(uid);
      allow update: if owns(uid) || isApprovedParentOf(uid);
      allow delete: if owns(uid);
    }

    match /{document=**} { allow read, write: if false; }
  }
}
