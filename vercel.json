{
  "installCommand": "cd ChildGrowthNative && npm install",
  "buildCommand": "cd ChildGrowthNative && npx expo export -p web",
  "outputDirectory": "ChildGrowthNative/dist",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/download",
      "destination": "/index.html"
    },
    {
      "source": "/apk",
      "destination": "/index.html"
    }
  ]
}
